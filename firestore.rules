rules_version = '2';

// RentEase Firestore security rules.
//
// Model:
// - users/{uid}          -> { role: "student" | "landlord" | "admin", email, updatedAt }
//   Admin is never client-writable; it must be set via a custom claim or
//   directly by a trusted backend (see scripts/setAdminClaim.mjs).
// - landlords/{uid}       -> public profile, doc id == owning landlord's auth uid
// - listings/{id}         -> landlordId must match the creating landlord's uid;
//                            only admins may change `status`.
// - conversations/{id}    -> participants: [studentUid, landlordUid]
//   conversations/{id}/messages/{id} -> from: uid of sender
// - reviews/{id}, reports/{id}, tenants/{id}, payments/{id} -> read-only from the
//   client for now (no submission UI yet); written by admin/backend only.

function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn() &&
    exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user manages only their own profile doc, and can never grant
    // themselves admin from the client.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) &&
        request.resource.data.role in ["student", "landlord"] &&
        (!("role" in resource.data) || resource.data.role != "admin");
      allow delete: if false;
    }

    match /landlords/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /listings/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.landlordId == request.auth.uid;
      // Owning landlord may edit their own listing but not its moderation status;
      // only an admin may change `status`.
      allow update: if isAdmin() ||
        (isSignedIn() &&
          resource.data.landlordId == request.auth.uid &&
          request.resource.data.landlordId == resource.data.landlordId &&
          request.resource.data.status == resource.data.status);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.landlordId == request.auth.uid);
    }

    match /conversations/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants &&
          request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // No submission UI yet for these — read-only from the client, written by
    // admins/backend jobs.
    match /reviews/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /tenants/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.landlordId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /payments/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.landlordId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
