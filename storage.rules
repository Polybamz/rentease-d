rules_version = '2';

// Listing photo uploads: any signed-in user may upload, but only into their
// own uid-prefixed folder, and only images under 8MB. Publicly readable since
// listing photos are shown to anonymous browsers on /browse.
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
